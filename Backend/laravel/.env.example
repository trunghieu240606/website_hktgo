APP_NAME="Website Thue Xe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# CẤU HÌNH KẾT NỐI DATABASE (Chọn 1 trong 2: MySQL hoặc PostgreSQL)
# ==============================================================================

# LỰA CHỌN 1: Dùng MySQL (Phổ biến với XAMPP / Laragon / MySQL Server)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_vehicle
DB_USERNAME=root
DB_PASSWORD=

# LỰA CHỌN 2: Dùng PostgreSQL (Khớp với thông tin db_vehicle cũ bên Java Spring Boot)
# Để kích hoạt PostgreSQL: Bỏ dấu # ở 6 dòng dưới và thêm # vào các dòng MySQL ở trên
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=db_vehicle
# DB_USERNAME=postgres
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# CẤU HÌNH GOOGLE GEMINI AI (Dán khóa API Gemini của bạn vào file .env)
# ==============================================================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
